@model WebApp.UI.Models.ApplicationUser
@{
    ViewData["Title"] = "Detalles del Usuario";
    var roles = ViewBag.Roles as IList<string>;
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-user-circle"></i> Detalles del Usuario</h2>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning me-2">
                <i class="fas fa-edit"></i> Editar
            </a>
            <a asp-action="Index" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Volver
            </a>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-8">
            <!-- Información Personal -->
            <div class="card mb-4">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-user me-2"></i>Información Personal</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Nombre Completo</label>
                            <div class="fw-bold">
                                @if (!string.IsNullOrEmpty(Model.FirstName) || !string.IsNullOrEmpty(Model.LastName))
                                {
                                    <span>@Model.FirstName @Model.LastName</span>
                                }
                                else
                                {
                                    <span class="text-muted">No especificado</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Correo Electrónico</label>
                            <div class="fw-bold">@Model.Email</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Nombre de Usuario</label>
                            <div class="fw-bold">@Model.UserName</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">ID de Usuario</label>
                            <div class="fw-bold">
                                <small class="font-monospace">@Model.Id</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Información de Autenticación -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-shield-alt me-2"></i>Información de Autenticación</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Proveedor de Autenticación</label>
                            <div>
                                @if (!string.IsNullOrEmpty(Model.GoogleId))
                                {
                                    <span class="badge bg-danger">
                                        <i class="fab fa-google me-1"></i> Google
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-primary">
                                        <i class="fas fa-envelope me-1"></i> Email / Contraseña
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Estado de la Cuenta</label>
                            <div>
                                @if (Model.IsActive)
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-check-circle me-1"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        <i class="fas fa-times-circle me-1"></i> Inactivo
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Email Confirmado</label>
                            <div>
                                @if (Model.EmailConfirmed)
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-check me-1"></i> Sí
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">
                                        <i class="fas fa-exclamation-triangle me-1"></i> No
                                    </span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Teléfono Confirmado</label>
                            <div>
                                @if (Model.PhoneNumberConfirmed)
                                {
                                    <span class="badge bg-success">
                                        <i class="fas fa-check me-1"></i> Sí
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">
                                        <i class="fas fa-exclamation-triangle me-1"></i> No
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Actividad -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-clock me-2"></i>Actividad</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Fecha de Registro</label>
                            <div class="fw-bold">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Última Modificación</label>
                            <div class="fw-bold">
                                <span class="text-muted">-</span>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Último Inicio de Sesión</label>
                            <div class="fw-bold">
                                @if (Model.LastLoginAt.HasValue)
                                {
                                    @Model.LastLoginAt.Value.ToString("dd/MM/yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">Nunca</span>
                                }
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="text-muted small">Intentos de Acceso Fallidos</label>
                            <div class="fw-bold">@Model.AccessFailedCount</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <!-- Roles Asignados -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h6 class="mb-0"><i class="fas fa-user-shield me-2"></i>Roles Asignados</h6>
                </div>
                <div class="card-body">
                    @if (roles != null && roles.Any())
                    {
                        <ul class="list-unstyled mb-0">
                            @foreach (var role in roles)
                            {
                                <li class="mb-2">
                                    @if (role == "Admin")
                                    {
                                        <span class="badge bg-danger fs-6">
                                            <i class="fas fa-user-shield me-1"></i> @role
                                        </span>
                                    }
                                    else if (role == "Facturador")
                                    {
                                        <span class="badge bg-primary fs-6">
                                            <i class="fas fa-file-invoice me-1"></i> @role
                                        </span>
                                    }
                                    else if (role == "Contador")
                                    {
                                        <span class="badge bg-success fs-6">
                                            <i class="fas fa-calculator me-1"></i> @role
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary fs-6">
                                            <i class="fas fa-user me-1"></i> @role
                                        </span>
                                    }
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-muted text-center py-3">
                            <i class="fas fa-info-circle me-2"></i>
                            Sin roles asignados
                        </div>
                    }
                </div>
            </div>

            <!-- Acciones -->
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-cogs me-2"></i>Acciones</h6>
                </div>
                <div class="card-body">
                    <div class="d-grid gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="fas fa-edit me-2"></i> Editar Usuario
                        </a>
                        
                        @if (Model.IsActive)
                        {
                            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-danger w-100" onclick="return confirm('¿Está seguro de desactivar este usuario?')">
                                    <i class="fas fa-user-slash me-2"></i> Desactivar Usuario
                                </button>
                            </form>
                        }
                        else
                        {
                            <button type="button" class="btn btn-success w-100" disabled>
                                <i class="fas fa-user-check me-2"></i> Usuario Inactivo
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
