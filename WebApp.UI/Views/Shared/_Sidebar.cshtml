<style>
    /* Estilos para el sidebar colapsable */
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        height: 100vh;
        z-index: 100;
        padding: 0;
        box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
        transition: all 0.3s ease;
        min-width: 250px;
        max-width: 250px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
        background-color: #f8f9fa;
    }

    .sidebar.collapsed {
        min-width: 80px;
        max-width: 80px;
    }

    .sidebar-content {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        padding-bottom: 1rem;
    }

    .sidebar-content::-webkit-scrollbar {
        width: 6px;
    }

    .sidebar-content::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .sidebar-content::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 3px;
    }

    .sidebar-content::-webkit-scrollbar-thumb:hover {
        background: #555;
    }

    .sidebar .sidebar-brand {
        transition: all 0.3s ease;
        white-space: nowrap;
        overflow: hidden;
        padding: 0.75rem 1rem;
    }

    .sidebar.collapsed .sidebar-brand {
        display: flex;
        justify-content: center !important;
        align-items: center;
        padding: 0.75rem 0;
    }

    .sidebar.collapsed .sidebar-brand a {
        display: flex !important;
        justify-content: center !important;
        align-items: center;
        margin: 0 !important;
        padding: 0 !important;
    }

    .sidebar.collapsed .sidebar-brand-text {
        opacity: 0;
        width: 0;
        display: none;
    }

    .sidebar.collapsed .sidebar-brand img {
        margin: 0 auto !important;
        display: block;
    }

    .sidebar .user-info {
        transition: all 0.3s ease;
        padding: 0 1rem 0.5rem 1rem;
    }

    .sidebar .user-info h5 {
        font-size: 1rem;
        margin-bottom: 0.25rem;
    }

    .sidebar .user-info small {
        font-size: 0.75rem;
    }

    .sidebar .user-info .rounded-circle,
    .sidebar .user-info img {
        width: 50px !important;
        height: 50px !important;
        font-size: 1.25rem;
    }

    .sidebar.collapsed .user-info h5,
    .sidebar.collapsed .user-info small {
        opacity: 0;
        height: 0;
        margin: 0;
        display: none;
    }

    .sidebar .nav-link {
        transition: all 0.3s ease;
        white-space: nowrap;
        overflow: hidden;
        padding: 0.6rem 1rem;
        margin-bottom: 0.25rem;
        border-radius: 0.25rem;
    }

    .sidebar .nav-link:hover {
        background-color: rgba(0, 123, 255, 0.1);
    }

    .sidebar .nav-link.active {
        background-color: #007bff;
        color: white !important;
        font-weight: bold; /* Añadir negrita */
        box-shadow: 0 2px 5px rgba(0,0,0,0.1); /* Añadir sombra sutil */
    }
    
    .sidebar.collapsed .nav-link.active i {
        color: white !important; /* Asegura que el icono también sea blanco cuando está colapsado */
    }

    .sidebar.collapsed .nav-link span {
        opacity: 0;
        width: 0;
        display: none;
    }

    .sidebar.collapsed .nav-link {
        text-align: center;
        padding-left: 0;
        padding-right: 0;
        justify-content: center;
    }

    .sidebar.collapsed .nav-link i {
        margin-right: 0 !important;
    }

    .sidebar .btn-logout {
        transition: all 0.3s ease;
    }

    .sidebar.collapsed .btn-logout span {
        display: none;
    }

    .sidebar-footer {
        position: relative;
        flex-shrink: 0;
        padding: 0.5rem 0.75rem 1rem 0.75rem;
        background: linear-gradient(180deg, #f8f9fa 0%, #e9ecef 100%);
        border-top: 1px solid #dee2e6;
    }

    .sidebar-footer hr {
        margin: 0.5rem 0;
    }

    .sidebar-footer .btn-logout {
        padding: 0.5rem;
        font-size: 0.875rem;
    }

    .sidebar.collapsed .sidebar-footer {
        padding: 0.5rem 0.5rem 1rem 0.5rem;
    }

    .toggle-sidebar {
        position: fixed;
        bottom: 5rem;
        left: 235px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #007bff;
        color: white;
        border: none;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        cursor: pointer;
        z-index: 1001;
        transition: left 0.3s ease, transform 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

    .sidebar.collapsed ~ .toggle-sidebar,
    .sidebar.collapsed .toggle-sidebar {
        left: 65px;
    }

    .toggle-sidebar:hover {
        background: #0056b3;
        transform: scale(1.15);
    }

    .main-content {
        margin-left: 250px;
        transition: all 0.3s ease;
        padding: 0 1rem;
        min-height: 100vh;
    }

    .sidebar.collapsed ~ .main-content {
        margin-left: 80px;
    }
</style>

<!-- Botón de toggle -->
<button class="toggle-sidebar" id="toggleSidebar" onclick="toggleSidebar()">
    <i class="fas fa-chevron-left" id="toggleIcon"></i>
</button>

<!-- Sidebar -->
<nav id="sidebar" class="sidebar">
    <div class="sidebar-content">
        <div class="sidebar-brand">
            <a class="navbar-brand fw-bold d-flex align-items-center text-decoration-none" asp-controller="Dashboard" asp-action="Index">
                <img class="me-2" src="~/Logo.png" alt="Logo" style="height: 28px; width: auto;" />
                <span class="text-gradient sidebar-brand-text" style="font-size: 1rem;">Facturación SaaS</span>
            </a>
        </div>

        <div class="text-center user-info">
            @if (!string.IsNullOrEmpty(User.FindFirst("picture")?.Value))
            {
                <img src="@User.FindFirst("picture")?.Value" alt="Foto de perfil" 
                     class="rounded-circle mb-2" style="width: 50px; height: 50px;">
            }
            else
            {
                <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2"
                     style="width: 50px; height: 50px; font-size: 1.25rem;">
                    @if (!string.IsNullOrEmpty(User.Identity?.Name))
                    {
                        @User.Identity.Name.Substring(0, 1).ToUpper()
                    }
                    else
                    {
                        <i class="fas fa-user"></i>
                    }
                </div>
            }
            <h5 class="mb-1">¡Bienvenido!</h5>
            <small class="text-muted">@User.Identity?.Name</small>
        </div>
        
        <ul class="nav flex-column px-2">
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Dashboard" ? "active" : "") d-flex align-items-center" 
                   asp-controller="Dashboard" asp-action="Index">
                    <i class="fas fa-tachometer-alt me-2"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Invoices" ? "active" : "") d-flex align-items-center" 
                   asp-controller="Invoices" asp-action="Index">
                    <i class="fas fa-file-invoice me-2"></i>
                    <span>Facturas</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Clients" ? "active" : "") d-flex align-items-center" 
                   asp-controller="Clients" asp-action="Index">
                    <i class="fas fa-users me-2"></i>
                    <span>Clientes</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Products" ? "active" : "") d-flex align-items-center" 
                   asp-controller="Products" asp-action="Index">
                    <i class="fas fa-box me-2"></i>
                    <span>Productos</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Payments" ? "active" : "") d-flex align-items-center" 
                   asp-controller="Payments" asp-action="Index">
                    <i class="fas fa-credit-card me-2"></i>
                    <span>Pagos</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Reports" ? "active" : "") d-flex align-items-center" 
                   asp-controller="Reports" asp-action="Index">
                    <i class="fas fa-chart-bar me-2"></i>
                    <span>Reportes</span>
                </a>
            </li>
            
            @if (User.IsInRole("Admin"))
            {
                <li class="nav-item mt-3">
                    <div class="px-3 py-1">
                        <small class="text-muted text-uppercase">Administración</small>
                    </div>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Companies" ? "active" : "") d-flex align-items-center" 
                       asp-controller="Companies" asp-action="Index">
                        <i class="fas fa-building me-2"></i>
                        <span>Empresas</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Users" ? "active" : "") d-flex align-items-center" 
                       asp-controller="Users" asp-action="Index">
                        <i class="fas fa-user-shield me-2"></i>
                        <span>Usuarios</span>
                    </a>
                </li>
            }
            
            <li class="nav-item mt-3">
                <a class="nav-link @(ViewContext.RouteData.Values["controller"]?.ToString() == "Settings" ? "active" : "") d-flex align-items-center" 
                   asp-controller="Settings" asp-action="Index">
                    <i class="fas fa-cog me-2"></i>
                    <span>Configuración</span>
                </a>
            </li>
        </ul>
    </div>

    <div class="sidebar-footer">
        <hr>
        <form asp-action="Logout" asp-controller="Account" method="post">
            <button type="submit" class="btn btn-outline-danger w-100 btn-logout d-flex align-items-center justify-content-center">
                <i class="fas fa-sign-out-alt me-2"></i>
                <span>Cerrar Sesión</span>
            </button>
        </form>
    </div>
</nav>

<!-- Mover el script fuera de la sección -->
<script>
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const toggleButton = document.getElementById('toggleSidebar');
        const toggleIcon = document.getElementById('toggleIcon');
        
        sidebar.classList.toggle('collapsed');
        
        if (sidebar.classList.contains('collapsed')) {
            toggleIcon.classList.remove('fa-chevron-left');
            toggleIcon.classList.add('fa-chevron-right');
            toggleButton.style.left = '65px';
        } else {
            toggleIcon.classList.remove('fa-chevron-right');
            toggleIcon.classList.add('fa-chevron-left');
            toggleButton.style.left = '235px';
        }
        
        localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
    }
    
    // Función para actualizar el elemento activo basado en la URL actual
    function updateActiveNavItem() {
        const currentPath = window.location.pathname.toLowerCase();
        const navLinks = document.querySelectorAll('.sidebar .nav-link');
        
        navLinks.forEach(link => {
            const href = link.getAttribute('href').toLowerCase();
            if (currentPath === href || 
                (currentPath.includes(href) && href !== '/')) {
                link.classList.add('active');
            } else {
                link.classList.remove('active');
            }
        });
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        const sidebar = document.getElementById('sidebar');
        const toggleButton = document.getElementById('toggleSidebar');
        const toggleIcon = document.getElementById('toggleIcon');
        const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
        
        if (isCollapsed) {
            sidebar.classList.add('collapsed');
            toggleIcon.classList.remove('fa-chevron-left');
            toggleIcon.classList.add('fa-chevron-right');
            toggleButton.style.left = '65px';
        }
        
        // Actualizar el elemento activo
        updateActiveNavItem();
    });
</script>

<!-- Puedes dejar vacía la sección Scripts o eliminarla si no la necesitas -->
@section Scripts {
    <!-- Ya no es necesario el código JavaScript aquí -->
}