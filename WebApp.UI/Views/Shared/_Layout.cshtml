<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Facturación SaaS</title>

    <!-- Fuentes -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@400;600&display=swap" rel="stylesheet">

    <!-- Librerías -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />

    <style>
        /* ===== NAVBAR FIJA Y MODERNA ===== */
        .navbar-floating {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            z-index: 1000;
            background-color: #007bff; /* Azul profesional */
            box-shadow: 0 2px 8px rgba(0,0,0,0.15);
            padding: 0.7rem 0;
        }

        .navbar .navbar-brand span {
            color: white;
            font-weight: 600;
            font-family: 'Poppins', sans-serif;
            letter-spacing: 0.5px;
        }

        .navbar .nav-link {
            color: #f0f0f0 !important;
            position: relative;
            font-weight: 500;
            transition: color 0.3s;
        }

            .navbar .nav-link:hover {
                color: #ffd43b !important;
            }

            /* Subrayado animado */
            .navbar .nav-link::after {
                content: "";
                position: absolute;
                left: 0;
                bottom: 0;
                width: 0%;
                height: 2px;
                background: #ffd43b;
                transition: width 0.3s ease-in-out;
            }

            .navbar .nav-link:hover::after {
                width: 100%;
            }

        /* ===== NUEVO BOTÓN REGISTRAR (TURQUESA) ===== */
        .btn-register {
            background-color: #17a2b8; /* Turquesa */
            color: white;
            border: none;
            transition: all 0.3s ease;
        }

            .btn-register:hover {
                background-color: #138496;
                transform: translateY(-2px);
            }

        /* Espaciado general del contenido (por navbar fija) */
        body {
            padding-top: 70px; /* Evita que el contenido quede oculto debajo de la navbar */
            font-family: 'Inter', sans-serif;
        }

        /* Footer con degradado */
        footer {
            background: linear-gradient(180deg, #1c1f24, #000);
            color: #ccc;
            font-family: 'Inter', sans-serif;
        }

            footer a {
                color: #aaa;
                transition: color 0.3s;
            }

                footer a:hover {
                    color: #fff;
                }

        /* Transiciones globales */
        * {
            transition: all 0.2s ease-in-out;
        }

        /* Ajuste visual para el logo */
        .navbar-brand img {
            height: 32px;
            width: auto;
        }
    </style>
</head>
<body>
    @if (!(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" &&
        ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard"))
    {
        <header class="navbar-floating">
            <nav class="navbar navbar-expand-lg navbar-dark">
                <div class="container">
                    <a class="navbar-brand fw-bold d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                        <img class="me-2" src="~/Logo.png" alt="Logo" />
                        <span class="fs-4">Facturación SaaS</span>
                    </a>

                    <button class="navbar-toggler custom-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse"
                            aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class="navbar-collapse collapse">
                        <ul class="navbar-nav me-auto ms-4">
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Index">Inicio</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Features">Características</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Pricing">Precios</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Home" asp-action="Support">Soporte</a></li>
                        </ul>

                        <ul class="navbar-nav ms-auto">
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <li class="nav-item dropdown">
                                    <a class="nav-link dropdown-toggle" href="#" id="navbarDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                        <i class="fas fa-user-circle me-1"></i> @User.Identity.Name
                                    </a>
                                    <ul class="dropdown-menu dropdown-menu-end">
                                        <li>
                                            <a class="dropdown-item" asp-controller="Account" asp-action="Dashboard">
                                                <i class="fas fa-tachometer-alt me-2"></i>Dashboard
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider" /></li>
                                        <li>
                                            <form asp-controller="Account" asp-action="Logout" method="post">
                                                <button type="submit" class="dropdown-item">
                                                    <i class="fas fa-sign-out-alt me-2"></i>Cerrar Sesión
                                                </button>
                                            </form>
                                        </li>
                                    </ul>
                                </li>
                            }
                            else
                            {
                                <li class="nav-item me-3">
                                    <a class="nav-link" asp-controller="Account" asp-action="Login">Iniciar Sesión</a>
                                </li>
                                <li class="nav-item">
                                    <a class="btn btn-register px-4 py-2 fw-semibold" asp-controller="Account" asp-action="Register">Registrar</a>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </nav>
        </header>
    }

    <main role="main" class="pb-3">
        @RenderBody()
    </main>

    @if (!(ViewContext.RouteData.Values["controller"]?.ToString() == "Account" &&
        ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard"))
    {
        <footer class="py-5 mt-5">
            <div class="container">
                <div class="row">
                    <div class="col-md-6">
                        <div class="d-flex align-items-center mb-3">
                            <img src="~/Logo.png" alt="Logo" style="height: 24px; width: auto;" class="me-2" />
                            <span class="fw-bold text-light">Facturación SaaS</span>
                        </div>
                        <p class="small mb-0">
                            La plataforma más completa para gestionar tu facturación electrónica con eficiencia y estilo.
                        </p>
                    </div>
                    <div class="col-md-6 text-md-end">
                        <div class="mb-2">
                            <a asp-controller="Home" asp-action="Privacy" class="me-3">Privacidad</a>
                            <a href="#" class="me-3">Términos</a>
                            <a href="#">Contacto</a>
                        </div>
                        <p class="text-muted small mb-0">&copy; @DateTime.Now.Year Facturación SaaS - Todos los derechos reservados.</p>
                    </div>
                </div>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
