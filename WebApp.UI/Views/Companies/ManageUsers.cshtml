@model WebApp.UI.Models.CompanyViewModel
@{
    ViewData["Title"] = "Gestionar Usuarios de la Empresa";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-users-cog"></i> Gestionar Usuarios - @Model.Name</h2>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="fas fa-arrow-left"></i> Volver
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="fas fa-users me-2"></i>Usuarios Asignados</h5>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-hover">
                            <thead>
                                <tr>
                                    <th>Usuario</th>
                                    <th>Email</th>
                                    <th>Rol en la Empresa</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle bg-primary text-white me-2">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <strong>Juan Pérez</strong>
                                        </div>
                                    </td>
                                    <td>juan.perez@empresa.com</td>
                                    <td>
                                        <span class="badge bg-danger">Administrador</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success">Activo</span>
                                    </td>
                                    <td>
                                        <form asp-action="RemoveUser" method="post" style="display:inline;">
                                            <input type="hidden" name="companyId" value="@Model.Id" />
                                            <input type="hidden" name="userId" value="user-id-123" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Está seguro de remover este usuario?')">
                                                <i class="fas fa-user-times"></i> Remover
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle bg-info text-white me-2">
                                                <i class="fas fa-user"></i>
                                            </div>
                                            <strong>María González</strong>
                                        </div>
                                    </td>
                                    <td>maria.gonzalez@empresa.com</td>
                                    <td>
                                        <span class="badge bg-primary">Facturador</span>
                                    </td>
                                    <td>
                                        <span class="badge bg-success">Activo</span>
                                    </td>
                                    <td>
                                        <form asp-action="RemoveUser" method="post" style="display:inline;">
                                            <input type="hidden" name="companyId" value="@Model.Id" />
                                            <input type="hidden" name="userId" value="user-id-456" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('¿Está seguro de remover este usuario?')">
                                                <i class="fas fa-user-times"></i> Remover
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0"><i class="fas fa-user-plus me-2"></i>Asignar Usuario</h6>
                </div>
                <div class="card-body">
                    <form asp-action="AssignUser" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="companyId" value="@Model.Id" />
                        
                        <div class="mb-3">
                            <label class="form-label">Usuario</label>
                            <select name="userId" class="form-select" required>
                                <option value="">Seleccionar usuario...</option>
                                <option value="user-1">Pedro Martínez (pedro@email.com)</option>
                                <option value="user-2">Ana López (ana@email.com)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Rol en la Empresa</label>
                            <select name="role" class="form-select" required>
                                <option value="">Seleccionar rol...</option>
                                <option value="Admin">Administrador</option>
                                <option value="Facturador">Facturador</option>
                                <option value="Contador">Contador</option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            <i class="fas fa-user-plus"></i> Asignar Usuario
                        </button>
                    </form>
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Información</h6>
                </div>
                <div class="card-body">
                    <ul class="small mb-0">
                        <li class="mb-2">Los usuarios deben estar registrados en la plataforma antes de ser asignados.</li>
                        <li class="mb-2">Cada usuario puede tener diferentes roles en diferentes empresas.</li>
                        <li class="mb-2">El rol Administrador tiene acceso completo a la empresa.</li>
                        <li>Los cambios de usuario se reflejan inmediatamente.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <style>
        .avatar-circle {
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
}
