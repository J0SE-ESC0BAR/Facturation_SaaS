@{
    ViewData["Title"] = "Empresas";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="fas fa-building"></i> Gestión de Empresas</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nueva Empresa
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row mb-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="fas fa-info-circle me-2"></i>Información</h5>
                </div>
                <div class="card-body">
                    <p class="mb-0">
                        Gestiona las empresas de tu cuenta. Puedes crear múltiples empresas y alternar entre ellas.
                        La empresa activa se mostrará en el dashboard y será usada para emitir facturas.
                    </p>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead>
                        <tr>
                            <th>Estado</th>
                            <th>Nombre Comercial</th>
                            <th>RNC/Cédula</th>
                            <th>Teléfono</th>
                            <th>Email</th>
                            <th>Usuarios</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <!-- Ejemplo de empresa -->
                        <tr>
                            <td>
                                <span class="badge bg-success">
                                    <i class="fas fa-check-circle"></i> Activa
                                </span>
                            </td>
                            <td><strong>Empresa Demo S.A.</strong></td>
                            <td>123-4567890-1</td>
                            <td>(809) 555-1234</td>
                            <td>contacto@empresademo.com</td>
                            <td>
                                <span class="badge bg-info">3 usuarios</span>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="1" class="btn btn-sm btn-info" title="Ver detalles">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="1" class="btn btn-sm btn-warning" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="ManageUsers" asp-route-id="1" class="btn btn-sm btn-secondary" title="Gestionar usuarios">
                                        <i class="fas fa-users"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-success" onclick="setActive(1)" title="Establecer como activa">
                                        <i class="fas fa-star"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <span class="badge bg-secondary">
                                    <i class="fas fa-circle"></i> Inactiva
                                </span>
                            </td>
                            <td>Empresa Secundaria EIRL</td>
                            <td>987-6543210-1</td>
                            <td>(809) 555-5678</td>
                            <td>info@secundaria.com</td>
                            <td>
                                <span class="badge bg-info">1 usuario</span>
                            </td>
                            <td>
                                <div class="btn-group" role="group">
                                    <a asp-action="Details" asp-route-id="2" class="btn btn-sm btn-info" title="Ver detalles">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="2" class="btn btn-sm btn-warning" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                    <a asp-action="ManageUsers" asp-route-id="2" class="btn btn-sm btn-secondary" title="Gestionar usuarios">
                                        <i class="fas fa-users"></i>
                                    </a>
                                    <button type="button" class="btn btn-sm btn-outline-success" onclick="setActive(2)" title="Establecer como activa">
                                        <i class="fas fa-star"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function setActive(companyId) {
            if (confirm('¿Desea establecer esta empresa como activa?')) {
                fetch('@Url.Action("SetActive", "Companies")/' + companyId, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]')?.value
                    }
                })
                .then(response => {
                    if (response.ok) {
                        window.location.reload();
                    }
                });
            }
        }
    </script>
}
