@* filepath: c:\Users\jose.escobar\Documents\Facturation_SaaS\WebApp.UI\Views\Error\AccessDenied.cshtml *@
@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = "_LayoutDashboard";
}

<div class="container-fluid">
    <div class="row justify-content-center align-items-center" style="min-height: 70vh;">
        <div class="col-md-6 text-center">
            <div class="mb-4">
                <i class="fas fa-lock fa-5x text-danger"></i>
            </div>
            <h1 class="display-4 mb-3">Acceso Denegado</h1>
            <p class="lead text-muted mb-4">
                No tienes permisos para acceder a este recurso.
            </p>
            <div class="d-flex gap-3 justify-content-center">
                <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary">
                    <i class="fas fa-home me-2"></i>Volver al Dashboard
                </a>
                @if (ViewData["ReturnUrl"] != null)
                {
                    <a href="@ViewData["ReturnUrl"]" class="btn btn-outline-secondary">
                        <i class="fas fa-arrow-left me-2"></i>Intentar de nuevo
                    </a>
                }
            </div>
        </div>
    </div>
</div>