@* filepath: c:\Users\jose.escobar\Documents\Facturation_SaaS\WebApp.UI\Views\Reports\Index.cshtml *@
@{
    ViewData["Title"] = "Reportes";
}

<div class="container-fluid">
    <h2 class="mb-4"><i class="fas fa-chart-bar"></i> Reportes</h2>

    <div class="row">
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-chart-line fa-3x text-primary mb-3"></i>
                    <h5>Reporte de Ventas</h5>
                    <p class="text-muted">Análisis de ventas por período</p>
                    <a asp-action="Sales" class="btn btn-primary">Ver Reporte</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-users fa-3x text-success mb-3"></i>
                    <h5>Reporte de Clientes</h5>
                    <p class="text-muted">Estadísticas de clientes</p>
                    <a asp-action="Clients" class="btn btn-success">Ver Reporte</a>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <div class="card-body text-center">
                    <i class="fas fa-box fa-3x text-warning mb-3"></i>
                    <h5>Reporte de Productos</h5>
                    <p class="text-muted">Productos más vendidos</p>
                    <a asp-action="Products" class="btn btn-warning">Ver Reporte</a>
                </div>
            </div>
        </div>
    </div>
</div>