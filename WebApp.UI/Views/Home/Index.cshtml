</section>

<!-- CTA Section -->
<section class="cta-modern-section">
    <div class="container">
        <div class="row text-center">
            <div class="col-lg-8 mx-auto">
                <h2 class="cta-title">¡Empieza a facturar de forma inteligente hoy mismo!</h2>
                <div class="cta-actions">
                    <a asp-controller="Account" asp-action="Register" class="btn-cta-primary me-3">
                        Pruébalo Gratis
                    </a>
                    <a asp-controller="Home" asp-action="Pricing" class="btn-cta-secondary">
                        Ver Precios
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
