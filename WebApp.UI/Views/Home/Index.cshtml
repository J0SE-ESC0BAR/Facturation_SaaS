@{
    ViewData["Title"] = "Inicio";
}

<!-- HERO PRINCIPAL -->
<section class="hero-with-image">
    <div class="hero-overlay"></div>
    <div class="container text-center">
        <div class="hero-content">
            <h1 class="hero-title text-white">Simplifica tu facturación con <span>Facturación SaaS</span></h1>
            <p class="hero-description text-white">
                Gestiona tus facturas electrónicas con facilidad, rapidez y seguridad.
                Una plataforma moderna diseñada para optimizar tu negocio.
            </p>
            <div class="hero-actions">
                <a asp-controller="Account" asp-action="Register" class="btn-hero-primary">Empieza gratis</a>
                <a asp-controller="Home" asp-action="Pricing" class="btn-hero-secondary">Ver planes</a>
            </div>
        </div>
    </div>
</section>

<!-- CARACTERÍSTICAS PRINCIPALES -->
<section class="features-section py-5">
    <div class="container text-center">
        <h2 class="section-title">🚀 Características que te encantarán</h2>
        <p class="section-description mb-5">Todo lo que necesitas para gestionar tus facturas de forma eficiente y profesional.</p>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="fas fa-file-invoice-dollar feature-icon"></i>
                    <h3>Facturación Rápida</h3>
                    <p>Crea y envía facturas en segundos con nuestra interfaz intuitiva y moderna.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="fas fa-chart-line feature-icon"></i>
                    <h3>Reportes Inteligentes</h3>
                    <p>Visualiza tus ingresos, ventas y clientes en gráficos dinámicos y fáciles de entender.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="feature-card">
                    <i class="fas fa-user-shield feature-icon"></i>
                    <h3>Protección Total</h3>
                    <p>Tus datos están 100% seguros con encriptación avanzada y respaldo en la nube.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SECCIÓN CÓMO FUNCIONA -->
<section class="how-it-works py-5 bg-light text-center">
    <div class="container">
        <h2 class="section-title">💼 ¿Cómo funciona?</h2>
        <p class="section-description mb-5">Solo tres pasos para comenzar a facturar sin complicaciones.</p>
        <div class="row g-4">
            <div class="col-md-4">
                <div class="step-card">
                    <span class="step-number">1</span>
                    <h4>Regístrate</h4>
                    <p>Crea una cuenta en menos de 2 minutos y configura tu empresa.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card">
                    <span class="step-number">2</span>
                    <h4>Emite tus facturas</h4>
                    <p>Genera tus facturas electrónicas desde cualquier dispositivo.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="step-card">
                    <span class="step-number">3</span>
                    <h4>Envía y controla</h4>
                    <p>Envía tus facturas a los clientes y controla tus pagos en tiempo real.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- TESTIMONIOS -->
<section class="testimonials py-5">
    <div class="container text-center">
        <h2 class="section-title">💬 Lo que dicen nuestros clientes</h2>
        <div class="row justify-content-center mt-4 g-4">
            <div class="col-md-4">
                <div class="testimonial-card">
                    <img src="https://randomuser.me/api/portraits/women/44.jpg" alt="Cliente" class="testimonial-img">
                    <p>“Con Facturación SaaS mi flujo de trabajo mejoró muchísimo. Es fácil, rápido y confiable.”</p>
                    <h5>María Torres</h5>
                    <span>Emprendedora</span>
                </div>
            </div>
            <div class="col-md-4">
                <div class="testimonial-card">
                    <img src="https://randomuser.me/api/portraits/men/32.jpg" alt="Cliente" class="testimonial-img">
                    <p>“El panel de control es increíble. Puedo ver mis ventas y facturas al instante.”</p>
                    <h5>Juan Pérez</h5>
                    <span>Contador</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA FINAL -->
<section class="cta-final text-center">
    <div class="container">
        <h2>¿Listo para optimizar tu negocio?</h2>
        <p>Únete a miles de empresas que ya facturan con nosotros.</p>
        <a asp-controller="Account" asp-action="Register" class="btn-hero-primary">Comenzar ahora</a>
    </div>
</section>
