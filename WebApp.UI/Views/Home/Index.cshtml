@{
    ViewData["Title"] = "Inicio";
}

<!-- Hero Section con imagen de fondo -->
<section class="hero-with-image">
    <div class="hero-overlay"></div>
    <div class="container">
        <div class="row justify-content-center text-center">
            <div class="col-lg-8">
                <div class="hero-content">
                    <h1 class="hero-title">
                        Simplifica tu facturación con Facturación SaaS
                    </h1>
                    <p class="hero-description">
                        Facturación SaaS es la solución completa para gestionar tus facturas electrónicas de forma eficiente y sin complicaciones. 
                        Ahorra tiempo y recursos con nuestra plataforma intuitiva y segura.
                    </p>
                    <div class="hero-actions">
                        <a asp-controller="Account" asp-action="Register" class="btn-hero-primary">
                            Empezar Gratis
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Features Section -->
<section class="features-modern-section">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="section-title">Características principales</h2>
                <p class="section-description">
                    Descubre cómo Facturación SaaS puede transformar tu proceso de facturación.
                </p>
            </div>
        </div>
        
        <div class="row g-4">
            <div class="col-lg-3 col-md-6">
                <div class="modern-feature-card">
                    <div class="feature-icon-modern">
                        <i class="fas fa-file-invoice"></i>
                    </div>
                    <h4 class="feature-title">Facturación ilimitada</h4>
                    <p class="feature-description">
                        Crea y envía facturas electrónicas ilimitadas sin preocuparte por límites.
                    </p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="modern-feature-card">
                    <div class="feature-icon-modern">
                        <i class="fas fa-clock"></i>
                    </div>
                    <h4 class="feature-title">Automatización</h4>
                    <p class="feature-description">
                        Automatiza tareas repetitivas como el envío de recordatorios de pago.
                    </p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="modern-feature-card">
                    <div class="feature-icon-modern">
                        <i class="fas fa-shield-alt"></i>
                    </div>
                    <h4 class="feature-title">Seguridad y Cumplimiento</h4>
                    <p class="feature-description">
                        Cumplimos con todas las normativas para garantizar la seguridad de tus datos.
                    </p>
                </div>
            </div>
            
            <div class="col-lg-3 col-md-6">
                <div class="modern-feature-card">
                    <div class="feature-icon-modern">
                        <i class="fas fa-users"></i>
                    </div>
                    <h4 class="feature-title">Gestión de Clientes</h4>
                    <p class="feature-description">
                        Organiza y gestiona la información de tus clientes en un solo lugar.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

