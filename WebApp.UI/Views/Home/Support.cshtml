@{
    ViewData["Title"] = "Soporte Técnico";
}

<link rel="stylesheet" href="~/css/soporte.css" />

<div class="support-container">
    <!-- Header -->
    <header class="support-header">
        <h1>Soporte Técnico</h1>
        <p>Estamos aquí para ayudarte. Envía tus dudas o problemas y nuestro equipo te responderá lo antes posible.</p>
    </header>

    <hr />

    <div class="support-sections">
        <!-- Formulario de contacto -->
        <section class="support-section support-contact">
            <h2>Contáctanos</h2>

            <form class="support-form" onsubmit="enviarCorreo(event)">
                <input type="text" id="nombre" placeholder="Nombre" required />
                <input type="email" id="email" placeholder="Correo electrónico" required />
                <textarea id="mensaje" placeholder="Mensaje" rows="5" required></textarea>
                <button type="submit">Enviar</button>
            </form>
        </section>

        <!-- FAQ -->
        <section class="support-section support-faq">
            <h2>Preguntas Frecuentes</h2>
            <ul class="faq-list">
                <li>¿Cómo restablezco mi contraseña?</li>
                <li>¿Dónde puedo ver el historial de soporte?</li>
                <li>¿Cuánto tarda la respuesta?</li>
            </ul>
        </section>
    </div>
</div>

<script>
    function enviarCorreo(event) {
        event.preventDefault(); // Evita recargar la página

        const nombre = document.getElementById("nombre").value;
        const email = document.getElementById("email").value;
        const mensaje = document.getElementById("mensaje").value;

        const destinatario = "contact@jaemsoftware.com";
        const asunto = encodeURIComponent("Consulta desde soporte web");
        const body = encodeURIComponent(`Nombre: ${nombre}\nCorreo: ${email}\nMensaje:\n${mensaje}`);

        // Abre el cliente de correo del usuario
        window.location.href = `mailto:${destinatario}?subject=${asunto}&body=${body}`;
    }
</script>
