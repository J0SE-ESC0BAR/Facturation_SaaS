@{
    ViewData["Title"] = "Precios y Planes";
}

<!-- Pricing Hero Section -->
<section class="pricing-hero-section">
    <div class="container">
        <div class="row text-center">
            <div class="col-lg-8 mx-auto">
                <h1 class="pricing-hero-title">Elige el plan perfecto para tu negocio</h1>
                <p class="pricing-hero-description">
                    Nuestros planes están diseñados para adaptarse a las necesidades de empresas de 
                    todos los tamaños. Compara las características y precios para encontrar la opción ideal.
                </p>
            </div>
        </div>
    </div>
</section>

<!-- Pricing Cards Section -->
<section class="pricing-cards-section">
    <div class="container">
        <div class="row g-4 justify-content-center">
            <!-- Plan Básico -->
            <div class="col-lg-4 col-md-6">
                <div class="pricing-plan-card">
                    <div class="plan-header">
                        <h3 class="plan-name">Básico</h3>
                        <div class="plan-price">
                            <span class="price-amount">$19</span>
                            <span class="price-period">/mes</span>
                        </div>
                        <p class="plan-description">Ideal para freelancers y pequeñas empresas que recién comienzan.</p>
                    </div>
                    
                    <div class="plan-features">
                        <ul class="features-list">
                            <li><i class="fas fa-check-circle"></i>Hasta 100 facturas al mes</li>
                            <li><i class="fas fa-check-circle"></i>Soporte por correo electrónico</li>
                            <li><i class="fas fa-check-circle"></i>Panel de control básico</li>
                            <li><i class="fas fa-check-circle"></i>Informes mensuales</li>
                        </ul>
                    </div>
                    
                    <div class="plan-action">
                        <a asp-controller="Account" asp-action="Register" class="btn-plan btn-plan-basic">
                            Seleccionar plan
                        </a>
                    </div>
                </div>
            </div>

            <!-- Plan Profesional -->
            <div class="col-lg-4 col-md-6">
                <div class="pricing-plan-card featured">
                    <div class="plan-badge">RECOMENDADO</div>
                    <div class="plan-header">
                        <h3 class="plan-name">Profesional</h3>
                        <div class="plan-price">
                            <span class="price-amount">$49</span>
                            <span class="price-period">/mes</span>
                        </div>
                        <p class="plan-description">Perfecto para negocios en crecimiento que necesitan más potencia.</p>
                    </div>
                    
                    <div class="plan-features">
                        <ul class="features-list">
                            <li><i class="fas fa-check-circle"></i>Facturas ilimitadas</li>
                            <li><i class="fas fa-check-circle"></i>Soporte prioritario</li>
                            <li><i class="fas fa-check-circle"></i>Panel de control avanzado</li>
                            <li><i class="fas fa-check-circle"></i>Informes personalizados</li>
                            <li><i class="fas fa-check-circle"></i>Integraciones con otras herramientas</li>
                        </ul>
                    </div>
                    
                    <div class="plan-action">
                        <a asp-controller="Account" asp-action="Register" class="btn-plan btn-plan-professional">
                            Seleccionar plan
                        </a>
                    </div>
                </div>
            </div>

            <!-- Plan Corporativo -->
            <div class="col-lg-4 col-md-6">
                <div class="pricing-plan-card">
                    <div class="plan-header">
                        <h3 class="plan-name">Corporativo</h3>
                        <div class="plan-price">
                            <span class="price-amount">$99</span>
                            <span class="price-period">/mes</span>
                        </div>
                        <p class="plan-description">Soluciones a medida para grandes empresas y corporaciones.</p>
                    </div>
                    
                    <div class="plan-features">
                        <ul class="features-list">
                            <li><i class="fas fa-check-circle"></i>Todo lo del plan Profesional, y además:</li>
                            <li><i class="fas fa-check-circle"></i>Soporte dedicado</li>
                            <li><i class="fas fa-check-circle"></i>Panel de control empresarial</li>
                            <li><i class="fas fa-check-circle"></i>Informes avanzados</li>
                            <li><i class="fas fa-check-circle"></i>Integraciones personalizadas</li>
                            <li><i class="fas fa-check-circle"></i>Acceso a API</li>
                        </ul>
                    </div>
                    
                    <div class="plan-action">
                        <a href="#" class="btn-plan btn-plan-corporate">
                            Seleccionar plan
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Pricing Comparison Table -->
<section class="pricing-comparison-section">
    <div class="container">
        <div class="row text-center mb-5">
            <div class="col-lg-8 mx-auto">
                <h2 class="comparison-title">Comparación detallada de planes</h2>
                <p class="comparison-description">
                    Analiza cada característica para tomar la mejor decisión para tu empresa.
                </p>
            </div>
        </div>
        
        <div class="comparison-table-container">
            <div class="table-responsive">
                <table class="comparison-table">
                    <thead>
                        <tr>
                            <th class="feature-column">Característica</th>
                            <th class="plan-column">Básico</th>
                            <th class="plan-column featured-column">Profesional</th>
                            <th class="plan-column">Corporativo</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td class="feature-name">Número de facturas</td>
                            <td>Hasta 100</td>
                            <td>Ilimitadas</td>
                            <td>Ilimitadas</td>
                        </tr>
                        <tr>
                            <td class="feature-name">Soporte</td>
                            <td>Correo electrónico</td>
                            <td>Prioritario</td>
                            <td>Dedicado</td>
                        </tr>
                        <tr>
                            <td class="feature-name">Panel de control</td>
                            <td>Básico</td>
                            <td>Avanzado</td>
                            <td>Empresarial</td>
                        </tr>
                        <tr>
                            <td class="feature-name">Informes</td>
                            <td>Mensuales</td>
                            <td>Personalizados</td>
                            <td>Avanzados</td>
                        </tr>
                        <tr>
                            <td class="feature-name">Integraciones</td>
                            <td><i class="fas fa-times text-danger"></i></td>
                            <td><i class="fas fa-check text-success"></i></td>
                            <td><i class="fas fa-check text-success"></i></td>
                        </tr>
                        <tr>
                            <td class="feature-name">Acceso a API</td>
                            <td><i class="fas fa-times text-danger"></i></td>
                            <td><i class="fas fa-times text-danger"></i></td>
                            <td><i class="fas fa-check text-success"></i></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</section>

<!-- FAQ Section -->
<section class="pricing-faq-section">
    <div class="container">
        <div class="row">
            <div class="col-lg-8 mx-auto">
                <h2 class="faq-title text-center mb-5">Preguntas frecuentes</h2>
                
                <div class="accordion" id="pricingFAQ">
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingOne">
                            <button class="accordion-button" type="button" data-bs-toggle="collapse" data-bs-target="#collapseOne">
                                ¿Puedo cambiar de plan en cualquier momento?
                            </button>
                        </h2>
                        <div id="collapseOne" class="accordion-collapse collapse show" data-bs-parent="#pricingFAQ">
                            <div class="accordion-body">
                                Sí, puedes cambiar de plan en cualquier momento. Los cambios se aplicarán inmediatamente y ajustaremos la facturación de manera proporcional.
                            </div>
                        </div>
                    </div>
                    
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingTwo">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseTwo">
                                ¿Hay algún compromiso a largo plazo?
                            </button>
                        </h2>
                        <div id="collapseTwo" class="accordion-collapse collapse" data-bs-parent="#pricingFAQ">
                            <div class="accordion-body">
                                No, todos nuestros planes son mensuales sin compromiso. Puedes cancelar tu suscripción en cualquier momento sin penalizaciones.
                            </div>
                        </div>
                    </div>
                    
                    <div class="accordion-item">
                        <h2 class="accordion-header" id="headingThree">
                            <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapseThree">
                                ¿Ofrecen descuentos por pago anual?
                            </button>
                        </h2>
                        <div id="collapseThree" class="accordion-collapse collapse" data-bs-parent="#pricingFAQ">
                            <div class="accordion-body">
                                Sí, ofrecemos un 20% de descuento en todos los planes cuando pagas anualmente. Contáctanos para más información.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
