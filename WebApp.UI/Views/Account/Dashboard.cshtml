@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<style>
    body {
        padding-top: 0 !important;
        overflow-x: hidden;
    }

    /* Estilos para el sidebar colapsable */
    .sidebar {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        height: 100vh;
        z-index: 100;
        padding: 0;
        box-shadow: inset -1px 0 0 rgba(0, 0, 0, .1);
        transition: all 0.3s ease;
        min-width: 250px;
        max-width: 250px;
        overflow: hidden;
        display: flex;
        flex-direction: column;
    }

    .sidebar.collapsed {
        min-width: 80px;
        max-width: 80px;
    }

    /* Contenedor de scroll del sidebar */
    .sidebar-content {
        flex: 1;
        overflow-y: auto;
        overflow-x: hidden;
        padding-bottom: 1rem;
    }

    /* Scrollbar personalizado para el sidebar */
    .sidebar-content::-webkit-scrollbar {
        width: 6px;
    }

    .sidebar-content::-webkit-scrollbar-track {
        background: #f1f1f1;
    }

    .sidebar-content::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 3px;
    }

    .sidebar-content::-webkit-scrollbar-thumb:hover {
        background: #555;
    }

    .sidebar .sidebar-brand {
        transition: all 0.3s ease;
        white-space: nowrap;
        overflow: hidden;
        padding: 0.75rem 1rem;
    }

    .sidebar.collapsed .sidebar-brand {
        display: flex;
        justify-content: center !important;
        align-items: center;
        padding: 0.75rem 0;
    }

    .sidebar.collapsed .sidebar-brand a {
        display: flex !important;
        justify-content: center !important;
        align-items: center;
        margin: 0 !important;
        padding: 0 !important;
    }

    .sidebar.collapsed .sidebar-brand-text {
        opacity: 0;
        width: 0;
        display: none;
    }

    .sidebar.collapsed .sidebar-brand img {
        margin: 0 auto !important;
        display: block;
    }

    .sidebar .user-info {
        transition: all 0.3s ease;
        padding: 0 1rem 0.5rem 1rem;
    }

    .sidebar .user-info h5 {
        font-size: 1rem;
        margin-bottom: 0.25rem;
    }

    .sidebar .user-info small {
        font-size: 0.75rem;
    }

    .sidebar .user-info .rounded-circle,
    .sidebar .user-info img {
        width: 50px !important;
        height: 50px !important;
        font-size: 1.25rem;
    }

    .sidebar.collapsed .user-info h5,
    .sidebar.collapsed .user-info small {
        opacity: 0;
        height: 0;
        margin: 0;
        display: none;
    }

    .sidebar .nav-link {
        transition: all 0.3s ease;
        white-space: nowrap;
        overflow: hidden;
        padding: 0.6rem 1rem;
        margin-bottom: 0.25rem;
    }

    .sidebar.collapsed .nav-link span {
        opacity: 0;
        width: 0;
        display: none;
    }

    .sidebar.collapsed .nav-link {
        text-align: center;
        padding-left: 0;
        padding-right: 0;
        justify-content: center;
    }

    .sidebar.collapsed .nav-link i {
        margin-right: 0 !important;
    }

    .sidebar .btn-logout {
        transition: all 0.3s ease;
    }

    .sidebar.collapsed .btn-logout span {
        display: none;
    }

    /* Footer del sidebar - Siempre visible al final del contenido */
    .sidebar-footer {
        position: relative;
        flex-shrink: 0;
        padding: 0.5rem 0.75rem 1rem 0.75rem; /* Padding inferior para el botón toggle */
        background: linear-gradient(180deg, #f8f9fa 0%, #e9ecef 100%);
        border-top: 1px solid #dee2e6;
    }

    .sidebar-footer hr {
        margin: 0.5rem 0;
    }

    .sidebar-footer .btn-logout {
        padding: 0.5rem;
        font-size: 0.875rem;
    }

    .sidebar.collapsed .sidebar-footer {
        padding: 0.5rem 0.5rem 1rem 0.5rem;
    }

    .toggle-sidebar {
        position: fixed;
        bottom: 5rem;
        left: 235px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #007bff;
        color: white;
        border: none;
        box-shadow: 0 2px 5px rgba(0,0,0,0.2);
        cursor: pointer;
        z-index: 1001;
        transition: left 0.3s ease, transform 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 0;
    }

    .sidebar.collapsed ~ .toggle-sidebar,
    .sidebar.collapsed .toggle-sidebar {
        left: 65px;
    }

    .toggle-sidebar:hover {
        background: #0056b3;
        transform: scale(1.15);
    }

    /* Main content ajustado al sidebar */
    .main-content {
        margin-left: 250px;
        transition: all 0.3s ease;
        padding: 0 1rem;
        min-height: 100vh;
    }

    .sidebar.collapsed ~ .main-content {
        margin-left: 80px;
    }
</style>

<div class="dashboard-wrapper">
    <!-- Botón de toggle -->
    <button class="toggle-sidebar" id="toggleSidebar" onclick="toggleSidebar()">
        <i class="fas fa-chevron-left" id="toggleIcon"></i>
    </button>

    <!-- Sidebar -->
    <nav id="sidebar" class="bg-light sidebar">
        <div class="sidebar-content">
            <div class="sidebar-brand">
                <a class="navbar-brand fw-bold d-flex align-items-center" asp-area="" asp-controller="Home" asp-action="Index">
                    <img class="me-2" src="~/Logo.png" alt="Logo" style="height: 28px; width: auto;" />
                    <span class="text-gradient sidebar-brand-text" style="font-size: 1rem;">Facturación SaaS</span>
                </a>
            </div>

            <div class="text-center user-info">
                @if (!string.IsNullOrEmpty(User.FindFirst("picture")?.Value))
                {
                    <img src="@User.FindFirst("picture")?.Value" alt="Foto de perfil" 
                         class="rounded-circle mb-2" style="width: 50px; height: 50px;">
                }
                else
                {
                    <div class="bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2"
                         style="width: 50px; height: 50px; font-size: 1.25rem;">
                        @if (!string.IsNullOrEmpty(User.Identity?.Name))
                        {
                            @User.Identity.Name.Substring(0, 1).ToUpper()
                        }
                        else
                        {
                            <i class="fas fa-user"></i>
                    }
                </div>
            }
            <h5 class="mb-1">¡Bienvenido!</h5>
            <small class="text-muted">@User.Identity?.Name</small>
        </div>
        
        <ul class="nav flex-column px-2">
            <li class="nav-item">
                <a class="nav-link active d-flex align-items-center" href="#">
                    <i class="fas fa-tachometer-alt me-2"></i>
                    <span>Dashboard</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center" href="#">
                    <i class="fas fa-file-invoice me-2"></i>
                    <span>Facturas</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center" href="#">
                    <i class="fas fa-users me-2"></i>
                    <span>Clientes</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center" href="#">
                    <i class="fas fa-box me-2"></i>
                    <span>Productos</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center" href="#">
                    <i class="fas fa-chart-bar me-2"></i>
                    <span>Reportes</span>
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link d-flex align-items-center" href="#">
                    <i class="fas fa-cog me-2"></i>
                    <span>Configuración</span>
                </a>
            </li>
        </ul>
        </div>

        <div class="sidebar-footer">
            <hr>
            <form asp-action="Logout" asp-controller="Account" method="post">
                <button type="submit" class="btn btn-outline-danger w-100 btn-logout d-flex align-items-center justify-content-center">
                    <i class="fas fa-sign-out-alt me-2"></i>
                    <span>Cerrar Sesión</span>
                </button>
            </form>
        </div>
    </nav>

    <!-- Main content -->
    <main class="main-content">
            <div class="d-flex justify-content-between flex-wrap flex-md-nowrap align-items-center pt-3 pb-2 mb-3 border-bottom">
                <h1 class="h2">Dashboard</h1>
                <div class="btn-toolbar mb-2 mb-md-0">
                    <div class="btn-group me-2">
                        <button type="button" class="btn btn-sm btn-outline-secondary">Exportar</button>
                    </div>
                    <button type="button" class="btn btn-sm btn-primary">
                        <i class="fas fa-plus me-1"></i>
                        Nueva Factura
                    </button>
                </div>
            </div>

            <!-- User Info Card -->
            <div class="row mb-4">
                <div class="col-12">
                    <div class="card border-primary">
                        <div class="card-header bg-primary text-white">
                            <h5 class="mb-0">
                                <i class="fas fa-user-circle me-2"></i>
                                Informaci�n de la Cuenta
                            </h5>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>Nombre:</strong> @User.Identity?.Name</p>
                                    <p><strong>Email:</strong> @User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Proveedor de Autenticaci�n:</strong> 
                                        @if (User.FindFirst("provider")?.Value == "Google")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="fab fa-google me-1"></i>Google
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary">
                                                <i class="fas fa-envelope me-1"></i>Email
                                            </span>
                                        }
                                    </p>
                                    <p><strong>ID de Usuario:</strong> @User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- KPI Cards -->
            <div class="row mb-4">
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-primary shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                        Facturas Este Mes</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">15</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-file-invoice fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-success shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                        Ingresos Este Mes</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">$25,450</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-warning shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                        Facturas Pendientes</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">7</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-clock fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="card border-left-info shadow h-100 py-2">
                        <div class="card-body">
                            <div class="row no-gutters align-items-center">
                                <div class="col mr-2">
                                    <div class="text-xs font-weight-bold text-info text-uppercase mb-1">
                                        Clientes Activos</div>
                                    <div class="h5 mb-0 font-weight-bold text-gray-800">42</div>
                                </div>
                                <div class="col-auto">
                                    <i class="fas fa-users fa-2x text-gray-300"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Invoices Table -->
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Facturas Recientes</h6>
                </div>
                <div class="card-body">
                    <div class="table-responsive">
                        <table class="table table-bordered" width="100%" cellspacing="0">
                            <thead>
                                <tr>
                                    <th>N�mero</th>
                                    <th>Cliente</th>
                                    <th>Fecha</th>
                                    <th>Estado</th>
                                    <th>Total</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>FAC-001</td>
                                    <td>Empresa ABC S.A.</td>
                                    <td>2024-01-15</td>
                                    <td><span class="badge bg-success">Pagada</span></td>
                                    <td>$1,250.00</td>
                                    <td>
                                        <button class="btn btn-sm btn-primary">Ver</button>
                                        <button class="btn btn-sm btn-secondary">PDF</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>FAC-002</td>
                                    <td>Comercial XYZ Ltda.</td>
                                    <td>2024-01-14</td>
                                    <td><span class="badge bg-warning">Pendiente</span></td>
                                    <td>$2,800.00</td>
                                    <td>
                                        <button class="btn btn-sm btn-primary">Ver</button>
                                        <button class="btn btn-sm btn-secondary">PDF</button>
                                    </td>
                                </tr>
                                <tr>
                                    <td>FAC-003</td>
                                    <td>Servicios DEF S.A.S.</td>
                                    <td>2024-01-13</td>
                                    <td><span class="badge bg-success">Pagada</span></td>
                                    <td>$750.00</td>
                                    <td>
                                        <button class="btn btn-sm btn-primary">Ver</button>
                                        <button class="btn btn-sm btn-secondary">PDF</button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </main>
    </div>

@section Scripts {
    <script src="https://kit.fontawesome.com/your-fontawesome-kit.js" crossorigin="anonymous"></script>
    
    <script>
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const toggleButton = document.getElementById('toggleSidebar');
            const toggleIcon = document.getElementById('toggleIcon');
            
            sidebar.classList.toggle('collapsed');
            
            // Cambiar el icono según el estado
            if (sidebar.classList.contains('collapsed')) {
                toggleIcon.classList.remove('fa-chevron-left');
                toggleIcon.classList.add('fa-chevron-right');
                toggleButton.style.left = '65px';
            } else {
                toggleIcon.classList.remove('fa-chevron-right');
                toggleIcon.classList.add('fa-chevron-left');
                toggleButton.style.left = '235px';
            }
            
            // Guardar el estado en localStorage
            localStorage.setItem('sidebarCollapsed', sidebar.classList.contains('collapsed'));
        }
        
        // Restaurar el estado del sidebar al cargar la página
        document.addEventListener('DOMContentLoaded', function() {
            const sidebar = document.getElementById('sidebar');
            const toggleButton = document.getElementById('toggleSidebar');
            const toggleIcon = document.getElementById('toggleIcon');
            const isCollapsed = localStorage.getItem('sidebarCollapsed') === 'true';
            
            if (isCollapsed) {
                sidebar.classList.add('collapsed');
                toggleIcon.classList.remove('fa-chevron-left');
                toggleIcon.classList.add('fa-chevron-right');
                toggleButton.style.left = '65px';
            }
        });
    </script>
}