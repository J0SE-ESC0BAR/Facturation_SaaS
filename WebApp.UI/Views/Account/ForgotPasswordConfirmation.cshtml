@{
    ViewData["Title"] = "Recuperación Enviada";
    Layout = "_Layout";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-4">
            <div class="card shadow">
                <div class="card-body p-4 text-center">
                    <i class="fas fa-envelope-circle-check text-success" style="font-size: 4rem;"></i>
                    <h2 class="h4 mt-3">¡Correo Enviado!</h2>
                    <p class="text-muted mb-4">
                        Si existe una cuenta con ese correo electrónico, hemos enviado un enlace 
                        para restablecer tu contraseña.
                    </p>
                    
                    <div class="alert alert-info">
                        <small>
                            <i class="fas fa-info-circle me-1"></i>
                            Revisa tu bandeja de entrada y la carpeta de spam.
                            El enlace expirará en 24 horas.
                        </small>
                    </div>

                    <div class="d-grid">
                        <a asp-action="Login" class="btn btn-primary">
                            <i class="fas fa-arrow-left me-2"></i>
                            Volver al Login
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>