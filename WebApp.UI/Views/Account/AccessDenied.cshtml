@{
    ViewData["Title"] = "Acceso Denegado";
    Layout = "_Layout";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="text-center">
                <div class="error mx-auto" data-text="403">403</div>
                <p class="lead text-gray-800 mb-5">Acceso Denegado</p>
                <p class="text-gray-500 mb-0">No tienes permisos para acceder a esta página.</p>
                <a asp-action="Login" asp-controller="Account">? Volver al Login</a>
            </div>
        </div>
    </div>
</div>

<style>
.error {
    font-size: 7rem;
    position: relative;
    line-height: 1;
    width: 12.5rem;
}

.error:before {
    content: attr(data-text);
    position: absolute;
    left: 0;
    color: #e74a3b;
    text-shadow: -1px 0px 0px #e74a3b, 0px 1px 0px #e74a3b, 1px 0px 0px #e74a3b, 0px -1px 0px #e74a3b;
}
</style>